{
  "manifest_version": 3,
  "name": "Koma – sprawdź, zanim udostępnisz",
  "short_name": "Koma",
  "version": "0.1.0",
  "description": "Zaznacz tekst na stronie, kliknij prawym przyciskiem i sprawdź prawdziwość informacji w Koma.",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": ["http://localhost:3000/*", "http://127.0.0.1:3000/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_page": "ustawienia.html",
  "action": {
    "default_title": "Koma – ustawienia",
    "default_icon": {
      "16": "ikony/ikona16.png",
      "32": "ikony/ikona32.png"
    }
  },
  "icons": {
    "16": "ikony/ikona16.png",
    "32": "ikony/ikona32.png",
    "48": "ikony/ikona48.png",
    "128": "ikony/ikona128.png"
  }
}
