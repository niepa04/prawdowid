# Skopiuj ten plik jako .env i uzupełnij wartości. Plik .env jest w .gitignore.
# Opis wszystkich ustawień: docs/konfiguracja.md (wartości domyślne: config/modele.js, config/ustawienia.js)

# Klucz do Google Fact Check Tools API (oceny Demagoga, Sprawdzam AFP, Konkret24, FakeNews.pl).
# Bez klucza Koma działa dalej, tylko bez ocen fact-checkerów.
# Jak założyć klucz: Google Cloud Console -> włącz "Fact Check Tools API" -> Dane logowania -> Klucz interfejsu API.
GOOGLE_FACTCHECK_API_KEY=

# Serwer Ollama z modelami AI (bez końcówki /api/...)
# OLLAMA_URL=http://127.0.0.1:11434

# Modele (muszą być pobrane w Ollamie: ollama pull <nazwa>)
# OCR_MODEL=glm-ocr:latest
# FILTR_MODEL=qwen3.5:9b
# KOMA_MODEL=qwen3.5:9b
# MONITORING_MODEL=qwen3.5:9b

# Serwer
# PORT=3000
# HOST=0.0.0.0
# KOMA_MAX_CZAS_MS=480000

# Monitoring promptów i system wczesnego ostrzegania (w tle)
# KOMA_MONITORING=1
# KOMA_MONITORING_DB=backend/dane/monitoring.sqlite
# KOMA_ALERT_PROG_GODZINA=5
# KOMA_ALERT_PROG_DZIEN=12
