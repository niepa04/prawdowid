# Skopiuj ten plik jako .env i uzupełnij wartości. Plik .env jest w .gitignore.

# Klucz do Google Fact Check Tools API (oceny Demagoga, Sprawdzam AFP, Konkret24, FakeNews.pl).
# Bez klucza Koma działa dalej, tylko bez ocen fact-checkerów.
# Jak założyć klucz: Google Cloud Console -> włącz "Fact Check Tools API" -> Dane logowania -> Klucz interfejsu API.
GOOGLE_FACTCHECK_API_KEY=
